# ---------------------------------------------------------------------------
# TEMPLATE - copy to `.env` and fill in.
# `.env` is git-ignored. Never commit real keys.
# ---------------------------------------------------------------------------

# ============================ AI PROVIDER (SECRET) ===========================
# These keys are read by the Node/Vite dev server ONLY. They are never sent to
# the browser: Vite forwards only `VITE_`-prefixed variables into the client
# bundle, and the browser talks to the local `/api/generate` route instead.
#
# AI_PROVIDER options: openai | gemini | openrouter | groq | together | ollama | custom
AI_PROVIDER=openai

# Required for every provider except `ollama`.
AI_API_KEY=

# Optional. Defaults per provider are built into server/aiProxy.ts
#   openai     -> https://api.openai.com/v1              | gpt-4o-mini
#   gemini     -> https://generativelanguage.googleapis.com/v1beta | gemini-2.0-flash
#   openrouter -> https://openrouter.ai/api/v1           | openai/gpt-4o-mini
#   groq       -> https://api.groq.com/openai/v1         | llama-3.3-70b-versatile
#   together   -> https://api.together.xyz/v1             | meta-llama/Llama-3.3-70B-Instruct-Turbo
#   ollama     -> http://127.0.0.1:11434                  | llama3.1
# Use AI_BASE_URL + AI_MODEL for any other OpenAI-compatible endpoint.
AI_BASE_URL=
AI_MODEL=

# Creativity (0 = factual/dry, 1 = wild) and response size.
AI_TEMPERATURE=0.8
AI_MAX_TOKENS=4000
AI_TIMEOUT_MS=60000

# Set to false to disable the proxy entirely (offline mode).
AI_PROXY_ENABLED=true

# Server-side secret. Signs an HttpOnly cookie so other websites cannot call
# http://localhost:5173/api/generate and burn your API quota.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=

# Requests per IP per minute.
AI_RATE_LIMIT=30

# ================================ APP SETTINGS ==============================
VITE_APP_NAME=SocialMediaRepurposer

# There are no client-visible secrets and no VITE_ variables to set: sign-in and
# cloud sync have been removed, so everything is stored in localStorage.
